{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.trustchain.id/v1/land_title.json",
  "title": "LAND_TITLE_V1",
  "description": "Standard Verifiable Credential Schema for Real Estate Deeds and Land Ownership",
  "type": "object",
  "required": [
    "deedNumber",
    "parcelId",
    "propertyAddress",
    "ownerName",
    "ownerDID",
    "registrarAuthority",
    "registrarDID",
    "registeredAt",
    "areaSqMeters",
    "geoCoordinates"
  ],
  "properties": {
    "deedNumber": {
      "type": "string",
      "description": "Government Registry Deed Number"
    },
    "parcelId": {
      "type": "string",
      "description": "Survey parcel identification number"
    },
    "propertyAddress": {
      "type": "string",
      "description": "Legal street address of property"
    },
    "ownerName": {
      "type": "string",
      "description": "Legal titleholder name"
    },
    "ownerDID": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:0x[a-fA-F0-9]{40}$",
      "description": "DID of titleholder"
    },
    "registrarAuthority": {
      "type": "string",
      "description": "Government land registrar department"
    },
    "registrarDID": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:0x[a-fA-F0-9]{40}$",
      "description": "DID of the land registry authority"
    },
    "registeredAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 registration date"
    },
    "areaSqMeters": {
      "type": "number",
      "minimum": 0.1,
      "description": "Land area in square meters"
    },
    "geoCoordinates": {
      "type": "string",
      "description": "Latitude and longitude polygon or point (e.g., '28.6139 N, 77.2090 E')"
    }
  },
  "additionalProperties": false
}
