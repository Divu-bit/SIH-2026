{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.trustchain.id/v1/software_license.json",
  "title": "SOFTWARE_LICENSE_V1",
  "description": "Standard Verifiable Credential Schema for Enterprise Software Licenses",
  "type": "object",
  "required": [
    "licenseKey",
    "productName",
    "licenseeOrganization",
    "licenseeDID",
    "issuerName",
    "issuerDID",
    "issuedAt",
    "seatLimit",
    "tier"
  ],
  "properties": {
    "licenseKey": {
      "type": "string",
      "description": "Unique cryptographic license identifier"
    },
    "productName": {
      "type": "string",
      "description": "Software product and major version"
    },
    "licenseeOrganization": {
      "type": "string",
      "description": "Entity receiving the software rights"
    },
    "licenseeDID": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:0x[a-fA-F0-9]{40}$",
      "description": "DID of the licensee"
    },
    "issuerName": {
      "type": "string",
      "description": "Software vendor name"
    },
    "issuerDID": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:0x[a-fA-F0-9]{40}$",
      "description": "DID of the software vendor"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 issuance timestamp"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 expiry timestamp"
    },
    "seatLimit": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of authorized concurrent seats"
    },
    "tier": {
      "type": "string",
      "enum": ["Community", "Professional", "Enterprise", "Unlimited"],
      "description": "License entitlement tier"
    }
  },
  "additionalProperties": false
}
